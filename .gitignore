# --- Secrets (never commit) ---
.env
.streamlit/secrets.toml

# --- Virtual environments ---
.venv*/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Data ---
# Raw downloads can be regenerated by the scripts, so keep them out of Git.
data/raw/*
!data/raw/.gitkeep
# Large rasters anywhere
*.tif
*.tiff
*.zip
